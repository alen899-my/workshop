# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get connection string from Neon dashboard → Connection Details → PSQL
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins or * for all
ALLOWED_ORIGIN=*

# ── Cloudflare R2 (Media Storage) ─────────────────────────────────────────────
# Create bucket at https://console.cloudflare.com → R2
CLOUDFLARE_R2_BUCKET=workshop
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# ── Email (Gmail SMTP / App Password) ─────────────────────────────────────────
# Get App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
